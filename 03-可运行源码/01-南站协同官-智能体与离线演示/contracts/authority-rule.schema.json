{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hubcoord.local/schemas/authority-rule.schema.json",
  "title": "HubCoord Authority Rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_id", "event_type", "spatial_scope", "proposed_action", "initiator_roles", "authority_level", "data_class", "decision", "required_human_roles", "source_ids", "rule_version"],
  "properties": {
    "rule_id": {"type": "string", "pattern": "^AR-[A-Z0-9-]+$"},
    "event_type": {"type": "string"},
    "spatial_scope": {"type": "string"},
    "proposed_action": {"type": "string"},
    "initiator_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "authority_level": {"type": "string", "enum": ["service", "coordination", "restricted"]},
    "data_class": {"type": "string", "enum": ["simulated", "redacted", "authorized", "public"]},
    "decision": {"type": "string", "enum": ["within_service_scope", "coordination_required", "restricted", "unknown"]},
    "required_human_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "boundary_reason": {"type": "string"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rule_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"}
  }
}
