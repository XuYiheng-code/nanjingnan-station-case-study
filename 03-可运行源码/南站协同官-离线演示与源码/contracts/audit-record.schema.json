{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hubcoord.local/schemas/audit-record.schema.json",
  "title": "HubCoord Demo Audit Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "card_id", "event_id", "action", "actor_role", "occurred_at", "reason", "data_status"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^AL-[A-Z0-9-]+$"},
    "card_id": {"type": "string", "pattern": "^CC-"},
    "event_id": {"type": "string", "pattern": "^NJS-"},
    "action": {"type": "string", "enum": ["drafted", "confirmed", "rejected", "escalated"]},
    "actor_role": {"type": "string"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "reason": {"type": "string", "minLength": 1},
    "data_status": {"const": "simulated"}
  }
}
