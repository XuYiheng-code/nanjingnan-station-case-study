{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hubcoord.local/schemas/manual-review-required.schema.json",
  "title": "HubCoord Manual Review Required",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "event_id", "reason_code", "message", "human_gate", "data_status"],
  "properties": {
    "status": {"const": "manual_review_required"},
    "event_id": {"type": "string", "pattern": "^NJS-"},
    "reason_code": {"type": "string", "enum": ["evidence_insufficient", "authority_unknown", "rule_conflict", "initiator_not_allowed", "validator_rejected"]},
    "message": {"type": "string", "minLength": 1},
    "human_gate": {"const": true},
    "data_status": {"type": "string", "enum": ["simulated", "redacted", "authorized"]}
  }
}
