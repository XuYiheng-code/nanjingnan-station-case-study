{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hubcoord.local/schemas/event.schema.json",
  "title": "HubCoord Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "scenario_id", "event_type", "data_status", "occurred_at", "spatial_scope", "signals", "status"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^NJS-(DEMO|PILOT)-[A-Z0-9-]+$"},
    "scenario_id": {"type": "string", "pattern": "^SC-[0-9]{2}$"},
    "event_type": {"type": "string", "enum": ["passenger_traffic_coupling", "parking_overflow", "public_order_risk", "facility_alert"]},
    "data_status": {"type": "string", "enum": ["simulated", "redacted", "authorized"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "spatial_scope": {"type": "string", "enum": ["station_interior", "parking_lot", "peripheral_road", "cross_boundary"]},
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal_id", "source_kind", "summary", "verification_status"],
        "properties": {
          "signal_id": {"type": "string"},
          "source_kind": {"type": "string", "enum": ["simulated_sensor", "simulated_report", "redacted_note", "public_policy"]},
          "summary": {"type": "string", "minLength": 1},
          "verification_status": {"type": "string", "enum": ["unverified", "corroborated", "confirmed"]}
        }
      }
    },
    "status": {"type": "string", "enum": ["new", "under_review", "closed"]}
  }
}
