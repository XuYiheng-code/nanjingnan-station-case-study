{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hubcoord.local/schemas/evidence-card.schema.json",
  "title": "HubCoord Evidence Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "source_id", "knowledge_version", "content_type", "excerpt", "provenance", "approval_status", "data_status"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^EV-[A-Z0-9-]+$"},
    "source_id": {"type": "string", "pattern": "^(INT|ORG|REG|SIM)-[A-Z0-9-]+$"},
    "knowledge_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
    "content_type": {"type": "string", "enum": ["observed_fact", "interview_view", "policy_text", "researcher_note", "simulation_assumption"]},
    "excerpt": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_title", "locator"],
      "properties": {
        "source_title": {"type": "string"},
        "locator": {"type": "string"},
        "speaker_or_author": {"type": "string"}
      }
    },
    "approval_status": {"type": "string", "enum": ["draft", "approved", "rejected"]},
    "data_status": {"type": "string", "enum": ["simulated", "redacted", "authorized", "public"]},
    "tags": {"type": "array", "items": {"type": "string"}}
  }
}
