{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hubcoord.local/schemas/coordination-card.schema.json",
  "title": "HubCoord Coordination Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["card_id", "event_id", "status", "data_status", "knowledge_version", "evidence_refs", "authority_refs", "authority_decision", "decision_trace", "recommended_next_step", "required_confirmations", "human_gate", "created_at"],
  "properties": {
    "card_id": {"type": "string", "pattern": "^CC-[A-Z0-9-]+$"},
    "event_id": {"type": "string"},
    "status": {"type": "string", "enum": ["draft", "pending_human_confirmation", "confirmed", "rejected", "escalated"]},
    "data_status": {"type": "string", "enum": ["simulated", "redacted", "authorized"]},
    "knowledge_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EV-"}},
    "authority_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^AR-"}},
    "authority_decision": {"type": "string", "enum": ["within_service_scope", "coordination_required", "restricted", "unknown"]},
    "decision_trace": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}},
    "summary": {"type": "string"},
    "recommended_next_step": {"type": "string", "enum": ["verify_evidence", "request_cross_party_confirmation", "escalate_for_human_review", "no_action"]},
    "required_confirmations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "boundary_notice": {"type": "string"},
    "human_gate": {"const": true},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
